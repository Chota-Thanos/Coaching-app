# tools/posting-agent-mcp — required environment variables.
#
# Copy this to `.env` in this same folder (gitignored — never commit real
# values) and fill in the real ones. Used by BOTH entry points:
#   - index.ts       (stdio, local clients — Claude Desktop / Claude Code)
#   - http-server.ts (remote clients, over HTTPS — see docs/claude-mcp-connection.md §11)
#
# On the production server this file lives at
# /var/www/coaching/tools/posting-agent-mcp/.env and is loaded by PM2 via
# `node --env-file=.env` (see ecosystem.config.cjs). It is never pulled by
# `git pull` and never overwritten by a deploy — set it once on the server.

# Base URL of the site this connector talks to. https://waytoias.com for the
# live site; http://localhost:4000 posts into your LOCAL dev database
# instead — content posted there will not appear on the live site, and a key
# minted for one will not authenticate against the other.
COACHING_API_URL=https://waytoias.com

# A service API key for the account this connector should act as. Mint one
# with:
#   npm run api:key -- create <admin-email> "<label>"
# Printed once, never recoverable.
COACHING_API_KEY=

# ── http-server.ts only — not read by the stdio entry point ─────────────────

# Required to start http-server.ts at all; it refuses to run without this
# (see the guard at the top of that file). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Give the SAME value to whatever remote client you configure, as an
# `Authorization: Bearer <token>` header. Anyone with this token can act as
# the account COACHING_API_KEY belongs to — treat it as seriously as a
# password, and mint a fresh one (don't reuse this across environments).
MCP_HTTP_BEARER_TOKEN=

# Defaults shown; usually fine to leave unset.
# MCP_HTTP_PORT=4100
# MCP_HTTP_HOST=127.0.0.1
